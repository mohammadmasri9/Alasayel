# Copy to .env.local if needed. Never commit real env files.

# Leave unset in development: requests go to /api and Vite proxies them
# to http://localhost:5000.
#
# REQUIRED in production (Vercel → Settings → Environment Variables):
# the backend API address. It is also written into the Content Security
# Policy, so the browser only talks to this API.
# VITE_API_URL=https://alasayel-api.onrender.com/api
