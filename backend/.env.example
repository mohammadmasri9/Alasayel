# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/alasayel?retryWrites=true&w=majority

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173

# Cloudinary (Dashboard -> API Keys). Required in production.
# If empty in development, images are saved to backend/uploads/ instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder in the media library
CLOUDINARY_FOLDER=alasayel

# Payment (later phase). Only "manual" (pay at the center) exists today.
# PAYMENT_PROVIDER=manual
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# Rate limits: requests per 15 minutes (defaults shown)
# RATE_LIMIT_AUTH=20      login / register / password change, per IP
# RATE_LIMIT_RESERVE=30   ticket reservations, per user
# RATE_LIMIT_API=1000     all API requests, per IP

# In production (NODE_ENV=production) the server refuses to start unless
# JWT_SECRET is long and random, CLIENT_URL uses https://, and Cloudinary
# is configured. See DEPLOYMENT.md.
